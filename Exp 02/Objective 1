clc;
clear;
close all;
frame = 4.615;
slots = 8;
slotTime = frame / slots;
timeAxis = 0:slotTime:frame;
subplot(2,1,1)
stem(timeAxis,ones(length(timeAxis),1),'filled')
title('TDMA Time Slot Structure')
xlabel('Time (ms)')
ylabel('Slot Level')
grid on
subplot(2,1,2)
plot(timeAxis,ones(size(timeAxis)),'o','LineWidth',1.5)
title('Continuous View of Slot Allocation')
xlabel('Time (ms)')
ylabel('Slot Presence')
grid on
