clc;
clear;
close all;
distance = 0.1:0.1:5;
frequency = [900 3500 28000];
loss900 = 32.44 + 20*log10(distance) + 20*log10(frequency(1));
loss3500 = 32.44 + 20*log10(distance) + 20*log10(frequency(2));
loss28000 = 32.44 + 20*log10(distance) + 20*log10(frequency(3));
figure
subplot(2,1,1)
plot(distance,loss900,'b','LineWidth',2)
hold on
plot(distance,loss3500,'r','LineWidth',2)
plot(distance,loss28000,'k','LineWidth',2)
title('Propagation Loss vs Distance')
xlabel('Distance (km)')
ylabel('Loss (dB)')
grid on
subplot(2,1,2)
freqAxis = frequency;
lossValue = [loss900(10) loss3500(10) loss28000(10)];
plot(freqAxis,lossValue,'-o','LineWidth',2)
title('Propagation Loss vs Frequency')
xlabel('Frequency (MHz)')
ylabel('Loss (dB)')
grid on
