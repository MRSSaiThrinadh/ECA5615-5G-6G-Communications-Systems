clc;
clear;
close all;
Fs = 1000;
time = 0:1/Fs:1;
totalBW = 600;
numUsers = 3;
channelBW = totalBW / numUsers;
carrier = [100 300 500];
msg = sin(2*pi*10*time);
user1 = msg .* cos(2*pi*carrier(1)*time);
user2 = msg .* cos(2*pi*carrier(2)*time);
user3 = msg .* cos(2*pi*carrier(3)*time);
subplot(2,1,1)
plot(time,user1,'r',time,user2,'g',time,user3,'b')
grid on
title('FDMA Channel Allocation')
xlabel('Time (s)')
ylabel('Amplitude')
subplot(2,1,2)
bw = channelBW * ones(1,numUsers);
bar(1:numUsers,bw)
grid on
title('Channel Bandwidth per User')
xlabel('Users')
ylabel('Channel Bandwidth (kHz)')
