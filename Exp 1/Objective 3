clc;
clear;
close all;
signalPower = 1;
noisePower = [0.1 0.05 0.01];
userID = 1:3;
snrValue = 10 * log10(signalPower ./ noisePower);
disp('User   Noise Power(W)   SNR(dB)')
disp([userID' noisePower' snrValue'])
figure
bar(userID,snrValue)
xlabel('Users')
ylabel('SNR (dB)')
title('Signal-to-Noise Ratio of FDMA Users')
grid on
