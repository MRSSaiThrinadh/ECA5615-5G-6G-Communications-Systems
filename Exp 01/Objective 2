clc;
clear;
close all;
channelBW = 200;
numUsers = 3;
modOrder = 2;
userRate = channelBW * log2(modOrder);
dataRate = repmat(userRate,1,numUsers);
disp('User Data Rate (kbps)')
disp([(1:numUsers)' dataRate'])
figure
bar(1:numUsers,dataRate)
xlabel('Users')
ylabel('Data Rate (kbps)')
title('FDMA Data Rate for Each User')
grid on
