clc;
clear;
close all;
userList = 1:8;
slotCount = 5;
allocation = zeros(1,length(userList));
allocation(1:slotCount) = 1;
notAllocated = ~allocation;
disp('User Wise Slot Allocation')
result = table(userList',allocation',...
    'VariableNames',{'User','Status_1_Allocated_0_Blocked'});
disp(result)
figure
subplot(2,1,1)
stem(userList,allocation,'filled','LineWidth',2)
title('TDMA Slot Allocation per User')
xlabel('User Index')
ylabel('Allocated')
ylim([-0.2 1.2])
grid on
subplot(2,1,2)
plot(userList,allocation,'-o','LineWidth',2)
hold on
plot(userList,notAllocated,'-s','LineWidth',2)
title('TDMA Slot Utilization Analysis')
xlabel('User Index')
ylabel('Status')
legend('Allocated','Blocked','Location','best')
ylim([-0.2 1.2])
grid on
