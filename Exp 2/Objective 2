clc;
clear;
close all;
slots = 8;
usedSlots = 6;
idleSlots = slots - usedSlots;
usage = (usedSlots / slots) * 100;
disp('Frame Utilization (%)')
disp(usage)
figure
subplot(2,1,1)
x = [1 2];
y = [usedSlots idleSlots];
plot(x,y,'-o','LineWidth',2)
title('GSM Frame Utilization (Allocated vs Free)')
xlabel('Slot Type Index (1=Allocated, 2=Free)')
ylabel('Number of Slots')
grid on
subplot(2,1,2)
pie([usedSlots idleSlots])
title('Slot Distribution in GSM Frame')
legend('Allocated','Free')
